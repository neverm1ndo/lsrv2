{
	"name": "extensions",
	"$schema": "../../node_modules/nx/schemas/project-schema.json",
	"sourceRoot": "tools/extensions/src",
	"projectType": "library",
	"tags": [],
	"targets": {
		"build": {
			"executor": "@nx/js:tsc",
			"outputs": ["{options.outputPath}"],
			"options": {
				"outputPath": "dist/tools/extensions",
				"main": "tools/extensions/src/index.ts",
				"tsConfig": "tools/extensions/tsconfig.lib.json",
				"assets": [
					"tools/extensions/*.md",
					{
						"input": "./tools/extensions/src",
						"glob": "**/!(*.ts)",
						"output": "./src"
					},
					{
						"input": "./tools/extensions/src",
						"glob": "**/*.d.ts",
						"output": "./src"
					},
					{
						"input": "./tools/extensions",
						"glob": "generators.json",
						"output": "."
					},
					{
						"input": "./tools/extensions",
						"glob": "executors.json",
						"output": "."
					}
				]
			}
		},
		"lint": {
			"executor": "@nx/eslint:lint"
		},
		"test": {
			"executor": "@nx/jest:jest",
			"outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
			"options": {
				"jestConfig": "tools/extensions/jest.config.cts"
			}
		}
	}
}
