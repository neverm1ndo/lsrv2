{
  "name": "lsrv2",
  "version": "0.0.1",
  "description": "New generation LAR server",
  "main": "index.ts",
  "author": "neverm1ndo",
  "license": "MIT",
  "private": true,
  "scripts": {
    "serve": "node --import=tsx --watch src/index.ts",
    "build": "tsc && tsup",
    "peggy:build-logs": "peggy -c ./libs/parser/src/lib/logs-parser/peg/peggy.config.mjs",
    "peggy:build-llql": "peggy -c ./libs/parser/src/lib/llql/peg/peggy.config.mjs",
    "check": "yarn exec biome check --write",
    "test": "nx vite:test run"
  },
  "tsup": {
    "entry": [
      "src/index.ts"
    ],
    "outDir": "dist",
    "format": [
      "esm"
    ],
    "target": "es2024",
    "sourcemap": true,
    "clean": true,
    "dts": false,
    "splitting": false,
    "treeshake": true,
    "skipNodeModulesBundle": true
  },
  "dependencies": {
