{
  "name": "@lsrv/observer",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/observer/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/observer",
        "main": "libs/observer/src/index.ts",
        "tsConfig": "libs/observer/tsconfig.lib.json",
        "assets": ["libs/observer/*.md"]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/observer/jest.config.cts"
      }
    }
  }
}
