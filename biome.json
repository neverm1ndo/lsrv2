{
	"$schema": "https://biomejs.dev/schemas/2.2.0/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**",
			"!**/*.parser.js",
			"!peggy.config.mjs",
			"!**/*.parser.d.ts",
			"!**/*.spec.ts",
			"!**/dist/*",
			"!**/node_modules/**/*"
		]
	},
	"formatter": {
		"enabled": true,
		"lineWidth": 120,
		"bracketSpacing": true,
		"lineEnding": "lf",
		"formatWithErrors": true
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": {
					"level": "on",
					"options": {
						"groups": [
							":NODE:",
							":BLANK_LINE:",
							["@nestjs/**", ":PACKAGE:", ":PACKAGE_WITH_PROTOCOL:", "!@lsrv/**"],
							":BLANK_LINE:",
							["@lsrv/**"],
							":BLANK_LINE:",
							":PATH:"
						]
					}
				}
			}
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"correctness": {
				"noUnusedImports": {
					"level": "error",
					"fix": "safe"
				},
				"noUnusedVariables": "warn"
			},
			"style": {
				"noMagicNumbers": "error",
				"noCommonJs": "error",
				"useImportType": "off",
				"useNamingConvention": {
					"level": "off",
					"options": { "strictCase": false }
				}
			},
			"suspicious": {
				"noEmptyInterface": "off",
				"noExplicitAny": "warn"
			},
			"complexity": {
				"noStaticOnlyClass": "off"
			}
		}
	},
	"javascript": {
		"formatter": {
			"enabled": true,
			"semicolons": "always",
			"lineEnding": "lf",
			"operatorLinebreak": "before",
			"trailingCommas": "none",
			"quoteStyle": "single"
		},
		"parser": {
			"unsafeParameterDecoratorsEnabled": true
		}
	}
}
