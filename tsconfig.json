{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "baseUrl": "./src",
    "lib": ["ESNext"],
    "paths": {
      "@lsrv/app": ["app/lsrv2.ts"],
      "@lsrv/core": ["../libs/core/src/index.ts"],
      "@lsrv/core/http": ["core/http/index.ts"],
      "@lsrv/core/db": ["core/db/index.ts"],
      "@lsrv/core/session": ["core/session/index.ts"],
      "@lsrv/core/socket": ["core/socket/index.ts"],
      "@lsrv/core/middlewares": ["core/middleware/index.ts"],
      "@lsrv/logger": ["core/logger/logger.ts"],
      "@lsrv/parser": ["../libs/parser/src/index.ts"],
      "@lsrv/observer": ["../libs/observer/src/index.ts"],
      "@lsrv/common/environment": ["common/env/index.ts"],
      "@lsrv/common/validation": ["common/validation/index.ts"],
      "@lsrv/common/decorators": ["common/decorators/index.ts"],
      "@lsrv/common/models": ["common/models/index.ts"],
      "@lsrv/common/mime": ["common/mime/mime.ts"],
      "@lsrv/models/response": ["models/response/index.ts"],
      "@lsrv/api": ["api/index.ts"],
      "@lsrv/api/user": ["api/user/index.ts"],
      "@lsrv/api/auth": ["api/auth/index.ts"],
      "@lsrv/api/health": ["api/health/index.ts"],
      "@lsrv/api/logs": ["api/player-sessions/index.ts"],
      "@lsrv/auth/feature": ["../libs/auth/feature/src/index.ts"],
      "@lsrv/auth/data-access": ["../libs/auth/data-access/src/index.ts"],
      "@lsrv/extensions": ["../tools/extensions/src/index.ts"],
      "config": ["../libs/config/src/index.ts"],
      "@lsrv/configurator": ["../libs/configurator/src/index.ts"]
    },
    "moduleResolution": "bundler",
    "outDir": "dist",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["vitest/globals"]
  },
  "include": ["src/**/*", "../libs/**/*", "../tools/**/*"],
  "exclude": ["node_modules"]
}
